<?xml version="1.0"?>
<!--  A gazebo plugin file that connect the URDF-written robot with the following gazebo plugins
1:"differential_drive_controller"  for differential drive simulation  
2:"camera_controller " for kinect simulation
/-->

<robot>

<!--  ++++++++++++++++++ Diff drive plugin++++++++++++++++++          /-->

<gazebo>

<!-- Skid steer for 4 motors Plugin -->

<plugin name="skid_steer_drive_controller" filename="libgazebo_ros_skid_steer_drive.so">
    <updateRate>100.0</updateRate>
    <robotNamespace></robotNamespace>
    <leftFrontJoint>wheel4_joint</leftFrontJoint>
    <rightFrontJoint>wheel3_joint</rightFrontJoint>
    <leftRearJoint>wheel2_joint</leftRearJoint>
    <rightRearJoint>wheel1_joint</rightRearJoint>
    <wheelSeparation>0.5</wheelSeparation>
    <wheelDiameter>0.3</wheelDiameter>
    <robotBaseFrame>chassis</robotBaseFrame>
    <torque>200</torque>
    <MaxForce>5.0</MaxForce>
    <commandTopic>cmd_vel</commandTopic>
    <odometryTopic>odom</odometryTopic>
    <odometryFrame>odom</odometryFrame>
    <broadcastTF>true</broadcastTF>
    <covariance_x>0.001</covariance_x> 
    <covariance_y>0.001</covariance_y> 
    <covariance_yaw>0.01</covariance_yaw> 
  </plugin>



