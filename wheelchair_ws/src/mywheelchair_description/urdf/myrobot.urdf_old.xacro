<!-- Define the camera link -->
<link name="camera_link">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="1.0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
    <visual name="camera_visual">
        <origin xyz="0.0 0.00 0.03" rpy="0 0 0.0"/>
        <geometry>
            <box size="0.1 0.2 0.04"/>
  	    <!-- <mesh filename="package://mywheelchair_description/meshes/kinect.dae"/> -->
        </geometry>
        <material name="camera_material">
            <color rgba="0.1 0.1 0.8 1.0"/>
            <texture filename=""/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.0 0.00 0.03" rpy="0 0 0.0"/>
        <geometry>
            <box size="0.1 0.2 0.04"/>
        </geometry>
    </collision>
</link>

<!-- Define the joint connecting camera link to its parent -->
<joint name="camera_joint" type="fixed">
    <parent link="camera_stand_link"/> 
    <!-- Replace 'camera_stand_link' with the correct parent link name -->
    <child link="camera_link"/>
    <origin xyz="0.0 0.0 0.21" rpy="0 0.0 0.0"/>
    <axis xyz="0.0 0.0 0.0"/>
     <!-- Check if you need a specific axis here -->
    <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/>  -->
    <!-- Set appropriate limits -->
</joint>




<!--  Kinect Optical Link and joints   /-->
<joint name="kinect_optical_joint" type="fixed">

    <!-- To invert the coordinates from image convention (Z is forward) to normal xyz /-->
    <origin xyz="0 0 0" rpy="-1.5707 0 -1.5707"/> 
    <parent link="camera_link"/>
    <child link="kinect_optical"/>
</joint>

<!--Virtual link to project the images to, and then flip it to us as its joint is flipped  /-->
<link name="kinect_optical">
</link>



