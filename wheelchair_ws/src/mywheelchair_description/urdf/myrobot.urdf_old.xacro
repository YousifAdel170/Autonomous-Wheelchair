<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" 
name="Self-driving_Wheelchair">

    <xacro:include filename="$(find mywheelchair_description)/urdf/mybot.gazebo" />

    <link name="chassis">
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.0 0.0 0.0 0.0"/>
                <texture filename=""/>
            </material>
        </visual>
    </link>

    <link name="imu_link">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1" />
            </material>
        </visual>
        <inertial>
            <mass value="0.001" />
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00000015" ixy="0" ixz="0" iyy="0.00000015" iyz="0" izz="0.00000015" />
        </inertial>
    </link>

    <joint name="imu_sensor_joint" type="fixed">
        <axis xyz="0 0 1" />
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>   
        <parent link="base_uplayer_link"/>
        <child link="imu_link"/>
    </joint>


    <link name="base_uplayer_link">
        <visual name='chassis_visual'>
            <origin xyz="0 0 0" rpy=" 0 0 0"/>
            <geometry>
                <box size=".61 0.68 .04"/>
            </geometry>
        </visual>    
    
        <inertial>
            <mass value="10.0"/>
            <origin xyz="0 0 0" rpy=" 0 0 0"/>
            <inertia
                ixx="0.5" ixy="0" ixz="0"
                iyy="1.0" iyz="0"
                izz="0.1"
            />
        </inertial>

        <collision name='collision'>
            <geometry>
                <box size=".61 0.7 .04"/>
            </geometry>
        </collision>

        <collision name='caster_collision'>
            <origin xyz="-0.2 0 -0.05" rpy=" 0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <surface>
                <friction>
                <ode>
                    <mu>0</mu>
                    <mu2>0</mu2>
                    <slip1>1.0</slip1>
                    <slip2>1.0</slip2>
                </ode>
                </friction>
            </surface>
        </collision>

        <visual name='caster_visual'>
            <origin xyz="0.0 0 -0.05" rpy=" 0 0 0"/>
            <geometry>
            <sphere radius="0.05"/>
            </geometry>
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>   <!-- here can control height from z -->
        <parent link="chassis"/>
        <child link="base_uplayer_link"/>
        <!-- here if link can move here choose axis who move around -->
        <axis xyz="0.0 0.0 0.0"/>
        <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> 
        <!-- currently we don't need limity  -->
    </joint>



    <!-- Back right wheel -->
    <joint name="wheel1_joint" type="continuous">
        <origin xyz="-0.3 -0.33 0.0" rpy="0.0 0.0 0.0" />
        <parent link="base_uplayer_link" />
        <child link="wheel1_link" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0" />
    </joint>

    <link name="wheel1_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <mass value="0.5" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
        <visual name="wheel1_visual">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
            <cylinder length="0.04" radius="0.15" />
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1" />
                <texture filename="" />
            </material>
        </visual>
        <collision name="wheel1_collision">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
            <cylinder length="0.04" radius="0.15" />
            </geometry>
        </collision>
    </link>

    <!-- Back left wheel -->
    <joint name="wheel2_joint" type="continuous">
        <origin xyz="-0.3 0.33 0" rpy="0.0 0.0 0.0" />
        <parent link="base_uplayer_link" />
        <child link="wheel2_link" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0" />
    </joint>
    
    <link name="wheel2_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <mass value="0.5" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
        <visual name="wheel2_visual">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
                <cylinder length="0.04" radius="0.15" />
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1" />
                <texture filename="" />
            </material>
        </visual>
        <collision name="wheel2_collision">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
                <cylinder length="0.04" radius="0.15" />
            </geometry>
        </collision>
    </link>
    <!-- front right wheel -->
    <joint name="wheel3_joint" type="continuous">
        <origin xyz="0.3 -0.33 0.0" rpy="0.0 0.0 0.0" />
        <parent link="base_uplayer_link" />
        <child link="wheel3_link" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0" />
    </joint>

    <link name="wheel3_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <mass value="0.5" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
        <visual name="wheel3_visual">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
                <cylinder length="0.04" radius="0.15" />
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1" />
                <texture filename="" />
            </material>
        </visual>
        <collision name="wheel3_collision">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
                <cylinder length="0.04" radius="0.15" />
            </geometry>
        </collision>
    </link>

    <!-- front left wheel -->
    <joint name="wheel4_joint" type="continuous">
        <origin xyz="0.3 0.33 0.0" rpy="0.0 0.0 0.0" />
        <parent link="base_uplayer_link" />
        <child link="wheel4_link" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0" />
    </joint>
    <link name="wheel4_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <mass value="0.5" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
        <visual name="wheel4_visual">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
                <cylinder length="0.04" radius="0.15" />
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1" />
                <texture filename="" />
            </material>
        </visual>
        <collision name="wheel4_collision">
            <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0" />
            <geometry>
                <cylinder length="0.04" radius="0.15" />
            </geometry>
        </collision>
    </link>
   

    <!-- All column links and joints -->
    <xacro:macro name="column" params="name x y">
    
        <link name="column_${name}_link">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.02"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial>
            <visual name="">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.04 0.04 0.23"/>
                </geometry>
                <material name="">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                    <texture filename=""/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.04 0.04 0.23"/>
                </geometry>
            </collision>
        </link>
        <joint name="column_${name}_joint" type="fixed">
        <!-- here make  x = 0.28 instead of x=0.285 to make column not touch wheel -->
            <origin xyz="${x} ${y} 0.145" rpy="0.0 0.0 0.0"/>
            <parent link="base_uplayer_link"/>
            <child link="column_${name}_link"/>
            <axis xyz="0.0 0.0 0.0"/>
            <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
        </joint>

    </xacro:macro>

    <!-- Back Left column create  using xacro macros-->
    <xacro:column name="back_left" x="-0.242" y="-0.27" />
    <!-- Back Right column create  using xacro macros-->
    <xacro:column name="back_right" x="0.242" y="-0.27" />
    <!-- Front Left column create  using xacro macros-->
    <xacro:column name="front_left" x="-0.242" y="0.27" />
    <!-- Front Right column create  using xacro macros-->
    <xacro:column name="front_right" x="0.242" y="0.27" />



 <!-- All Parallel column link and joint -->

    <xacro:macro name="parallelColumn" params="name y">
        
        
        <link name="conect_2_${name}_link">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.02"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial>
            <visual name="">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.525 0.04 0.04"/>
                </geometry>
                <material name="">
                    <color rgba="1.0 1.0 0.0 1.0"/>
                    <texture filename=""/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.525 0.04 0.04"/>
                </geometry>
            </collision>
        </link>
        <joint name="conect_2_${name}_joint" type="fixed">
            <origin xyz=" 0.0 ${y} 0.25" rpy="0.0 0.0 0.0"/>
            <parent link="base_uplayer_link"/>
            <child link="conect_2_${name}_link"/>
            <axis xyz="0.0 0.0 0.0"/>
            <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
        </joint>
    </xacro:macro>
    <!-- left parallel column create using macros -->
    <xacro:parallelColumn name="left_columns" y="-0.27" />
    <!-- right parallel column create using macros -->
    <xacro:parallelColumn name="right_columns" y="0.27" />
    <!-- left parallel column create using macros -->


    <!-- create seat link and joint  -->
    <link name="seat_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.4 0.5 0.04"/>
            </geometry>
            <material name="">
                <color rgba="0.0 0.0 0.0 1.0"/>
                <texture filename=""/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.4 0.5 0.04"/>
            </geometry>
        </collision>
    </link>
    <joint name="seat_joint" type="fixed">
        <origin xyz="-0.04 0.0 0.25" rpy="0.0 0.0 0.0"/>
        <parent link="base_uplayer_link"/>
        <child link="seat_link"/>
        <axis xyz="0.0 0.0 0.0"/>
        <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
    </joint>


    <!-- All vertical column for stand  link and joint -->
    <xacro:macro name="carriage_stand" params="name x y">

        <link name="carriage_stand_${name}_link">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.02"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial>
            <visual name="">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.05 0.04 0.115"/>
                </geometry>
                <material name="">
                    <color rgba="0.0 0.5 0.5 1.0"/>
                    <texture filename=""/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.05 0.04 0.115"/>
                </geometry>
            </collision>
        </link>
        <joint name="carriage_stand_${name}_joint" type="fixed">
            <origin xyz="${x} ${y} 0.07" rpy="0.0 0.0 0.0"/>
            <parent link="seat_link"/>
            <child link="carriage_stand_${name}_link"/>
            <axis xyz="0.0 0.0 0.0"/>
            <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
        </joint>

    </xacro:macro>
    <!-- create left carriage_stand using macro -->
    <xacro:carriage_stand name="left_top" x="-0.175" y="-0.27"/>
    <!-- create right carriage_stand using macro -->
    <xacro:carriage_stand name="right_top" x= "-0.175" y="0.27"/>

    <!-- create left carriage_stand using macro -->
    <xacro:carriage_stand name="left_bottom" x="0.125" y="-0.27"/>
    <!-- create right carriage_stand using macro -->
    <xacro:carriage_stand name="right_bottom" x="0.125" y="0.27"/>
    

    <!-- All Parallel column for stand  link and joint -->
    <xacro:macro name="parallel_stand" params="name y">

        <link name="parallel_stand_${name}_link">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.02"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial>
            <visual name="">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.35 0.04 0.04"/>
                </geometry>
                <material name="">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                    <texture filename=""/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.35 0.04 0.04"/>
                </geometry>
            </collision>
        </link>
        <joint name="parallel_stand_${name}_joint" type="fixed">
            <origin xyz="-0.025 ${y} 0.13" rpy="0.0 0.0 0.0"/>
            <parent link="seat_link"/>
            <child link="parallel_stand_${name}_link"/>
            <axis xyz="0.0 0.0 0.0"/>
            <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
        </joint>

    </xacro:macro>
    <!-- create left parallel stand (actaully stand ) using macros -->
    <xacro:parallel_stand name="left" y="-0.27"/>
    <!-- create right parallel stand (actaully stand ) using macros -->
    <xacro:parallel_stand name="right" y="0.27"/>


 <!-- All column for Back seat link and joint -->
    <xacro:macro name="column_back" params="name y">

        <link name="column_back_seat_${name}_link">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.02"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial>
            <visual name="">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.05 0.05 0.4"/>
                </geometry>
                <material name="">
                    <color rgba="0.7 0.7 0.7 1.0"/>
                    <texture filename=""/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.05 0.05 0.4"/>
                </geometry>
            </collision>
        </link>
        <joint name="column_back_seat_${name}_joint" type="fixed">
            <origin xyz="-0.2 ${y} 0.22" rpy="0.0 0.0 0.0"/>
            <parent link="seat_link"/>
            <child link="column_back_seat_${name}_link"/>
            <axis xyz="0.0 0.0 0.0"/>
            <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
        </joint>
    </xacro:macro>
    <!-- create left column that will used to make back seat using macros -->
    <xacro:column_back name="left" y="-0.23 "/>
    <!-- create right column that will used to make back seat using macros -->
    <xacro:column_back name="right" y="0.23 "/>


<!-- create back link and jont -->
    <link name="back_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.04 0.41 0.41"/>
            </geometry>
            <material name="">
                <color rgba="1.0 0.0 0.0 1.0"/>
                <texture filename=""/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.41 0.41"/>
            </geometry>
        </collision>
    </link>
    <joint name="back_joint" type="fixed">
        <origin xyz="-0.2 0.0 0.22" rpy="0.0 0.0 0.0"/>
        <parent link="seat_link"/>
        <child link="back_link"/>
        <axis xyz="0.0 0.0 0.0"/>
        <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/>
    </joint>


    <!-- All handle to move chair link and joint -->
    <xacro:macro name="handle_chair" params="name parent_link ">
    
        <link name="handle_${name}_link">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.02"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial>
            <visual name="">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.08"/>
                </geometry>
                <material name="">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                    <texture filename=""/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.08"/>
                </geometry>
            </collision>
        </link>
        <!-- 0.0 -0.04 0.13" -->
        <joint name="handle_${name}_joint" type="fixed">
            <origin xyz="-0.04 0.0 0.15" rpy="0.0 1.57 0.0"/>
            <parent link="${parent_link}"/>
            <child link="handle_${name}_link"/>
            <axis xyz="0.0 0.0 0.0"/>
            <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
        </joint>

    </xacro:macro>

    <xacro:handle_chair name="left" parent_link="column_back_seat_left_link" />
    <xacro:handle_chair name="right" parent_link="column_back_seat_right_link" />



 <!-- create stand for camera link and joint -->
    <link name="camera_stand_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.05 0.05 0.435 "/>
            </geometry>
            <material name="">
                <color rgba="0.2 1.0 0.5 1.0"/>
                <texture filename=""/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.05 0.04 0.435 "/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_stand_joint" type="fixed">
        <origin xyz="-0.22 0.0 0.57" rpy="0.0 0.0 0.0"/>
        <parent link="seat_link"/>
        <child link="camera_stand_link"/>
        <axis xyz="0.0 0.0 0.0"/>
        <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
    </joint>


 <!-- Camera Reference -->
    <!-- <joint name="camera_joint" type="fixed">
        <origin xyz="0.0 0 0.23" rpy="0.0 0.0 0.0" />
        <parent link="camera_stand_link" />
        <child link="camera_link" />
        <axis xyz="0.0 0.0 0.0" />
    </joint>
