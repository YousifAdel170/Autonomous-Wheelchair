<?xml version="1.0"?>
<launch>

    <!-- Run the EKF Localization node -->
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization">
    <param name="imu_rate" value="100"/>
    <param name="odom_rate" value="50"/>
    <param name="imu_buffer_size" value="100"/>
     	<rosparam command="load" file="$(find wheelchair_summit_odometry)/config/ekf_localization.yaml"/>
    </node>

</launch>
